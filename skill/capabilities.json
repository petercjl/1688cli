{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "1688cli",
  "target_platforms": [
    "codex",
    "sealseek",
    "workbuddy"
  ],
  "capabilities": [
    {
      "id": "sourcing.product.text-search",
      "purpose": "Search 1688 products by an explicit recorded keyword and return normalized product evidence.",
      "required": true,
      "required_features": [
        "read_only_platform_query",
        "utf8_keyword",
        "structured_json",
        "source_provenance"
      ],
      "input_fields": [
        "query",
        "limit",
        "output_path"
      ],
      "output_fields": [
        "products",
        "query",
        "count",
        "source_file"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "use the configured official 1688 AK for read-only queries; create a new local JSON file only"
      },
      "errors": [
        "AUTH_REQUIRED",
        "ACCESS_DENIED",
        "PROVIDER_MISSING",
        "PROVIDER_TIMEOUT",
        "OUTPUT_EXISTS"
      ]
    },
    {
      "id": "sourcing.product.image-search",
      "purpose": "Search 1688 products from one CLI-accessible user or provider-returned reference image while retaining image provenance.",
      "required": true,
      "required_features": [
        "read_only_platform_query",
        "local_path_or_https_url",
        "one_image_per_call",
        "structured_json",
        "source_provenance"
      ],
      "input_fields": [
        "reference_id",
        "image_path_or_url",
        "limit",
        "output_path"
      ],
      "output_fields": [
        "products",
        "reference_id",
        "count",
        "source_file"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "use the configured official 1688 AK for read-only queries; create a new local JSON file only"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "ACCESS_DENIED",
        "PROVIDER_MISSING",
        "PROVIDER_TIMEOUT",
        "OUTPUT_EXISTS"
      ]
    },
    {
      "id": "sourcing.supplier.search",
      "purpose": "Optionally find supplier profiles when the product list alone does not identify enough merchant information.",
      "required": false,
      "required_features": [
        "read_only_platform_query",
        "structured_json",
        "source_provenance"
      ],
      "input_fields": [
        "query",
        "output_path"
      ],
      "output_fields": [
        "suppliers",
        "count",
        "source_file"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "use configured official 1688 AK for read-only supplier query; create a new local JSON file only"
      },
      "errors": [
        "AUTH_REQUIRED",
        "ACCESS_DENIED",
        "PROVIDER_MISSING",
        "PROVIDER_TIMEOUT",
        "OUTPUT_EXISTS"
      ]
    }
  ]
}
