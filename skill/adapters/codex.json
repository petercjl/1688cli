{
  "schema": "portable-skill-adapter",
  "schema_version": "1.0.0",
  "platform": "codex",
  "mappings": [
    {
      "capability_id": "sourcing.product.text-search",
      "status": "tested",
      "implementation": {
        "kind": "stable-cli",
        "command": "1688cli products search <query> --limit <n> --output <new-path>.json",
        "probe": "1688cli doctor --json; 1688cli capabilities --json"
      },
      "features": [
        "read_only_platform_query",
        "utf8_keyword",
        "structured_json",
        "source_provenance"
      ],
      "permissions": [
        "read configured official 1688 AK",
        "write a new JSON file"
      ],
      "normalization": "Read JSON products[] and retain each product source plus the explicit search ID in the research ledger.",
      "tested_date": "2026-09-28",
      "evidence": [
        "On Codex/macOS, 1688cli products search 不粘平底锅 --limit 3 returned normalized product rows through the installed official Skill."
      ]
    },
    {
      "capability_id": "sourcing.product.image-search",
      "status": "tested",
      "implementation": {
        "kind": "stable-cli",
        "command": "1688cli products image <local-path-or-https-url> --limit <n> --output <new-path>.json",
        "probe": "1688cli doctor --json; 1688cli capabilities --json"
      },
      "features": [
        "read_only_platform_query",
        "local_path_or_https_url",
        "one_image_per_call",
        "structured_json",
        "source_provenance"
      ],
      "permissions": [
        "read user image or 1688cli-returned image URL",
        "read configured official 1688 AK",
        "write a new JSON file"
      ],
      "normalization": "Associate each response with the reference ID that produced the CLI call; do not merge distinct references without evidence.",
      "tested_date": "2026-09-28",
      "evidence": [
        "On Codex/macOS, an HTTPS product image returned by keyword search was passed to 1688cli products image and produced three normalized rows."
      ]
    },
    {
      "capability_id": "sourcing.supplier.search",
      "status": "tested",
      "implementation": {
        "kind": "stable-cli",
        "command": "1688cli suppliers search <query> --output <new-path>.json",
        "probe": "1688cli doctor --json"
      },
      "features": [
        "read_only_platform_query",
        "structured_json",
        "source_provenance"
      ],
      "permissions": [
        "read configured official 1688 AK",
        "write a new JSON file"
      ],
      "normalization": "Read suppliers[] and match to product merchants only on direct identity evidence.",
      "tested_date": "2026-09-28",
      "evidence": [
        "On Codex/macOS, 1688cli suppliers search 平底锅工厂 returned seven normalized supplier rows."
      ]
    }
  ]
}
